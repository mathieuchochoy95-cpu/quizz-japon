rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Les joueurs peuvent seulement CRÉER une réponse au bon format
    match /reponses/{id} {
      allow create: if request.resource.data.keys().hasOnly(['prenom', 'reponses', 'date'])
        && request.resource.data.prenom is string
        && request.resource.data.prenom.size() > 0
        && request.resource.data.prenom.size() <= 30
        && request.resource.data.reponses is list
        && request.resource.data.reponses.size() == 9
        && request.resource.data.date == request.time;

      // Seul l'admin connecté peut lire, corriger ou supprimer
      allow read, update, delete: if request.auth != null;
    }

    // Les bonnes réponses : uniquement pour l'admin connecté
    match /quiz/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
